# PHP front controller
DirectoryIndex web-router.php

RewriteEngine On

# --- Bezpečnosť: interné a vývojové súbory nesmú byť verejne dostupné ---
# (skripty buildu, pomocné súbory, skryté súbory ako .php_mail_counter)
# .well-known nechávame dostupné kvôli obnove SSL certifikátu.
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteRule (^|/)\. - [F]
RewriteRule ^_ - [F]
RewriteRule \.py$ - [F]
RewriteRule \.(sh|bak|log|ini|md|yml|yaml)$ - [F]

# .env obsahuje VŠETKY tajomstvá (Cloudflare, Railway, e-maily, admin).
# Dotfile pravidlo vyššie ho už blokuje, toto je druhá poistka.
RedirectMatch 404 (?i)^/\.env

# Zdrojové/prekladové podklady nesmú byť verejné
RewriteRule ^preklad/_zdroj - [F]

# Existing files/dirs (assets, images, PHP scripts) are served directly
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
# Everything else goes through the router
RewriteRule ^ web-router.php [QSA,L]

# --- Bezpečnostné hlavičky ---
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set X-Permitted-Cross-Domain-Policies "none"
    Header always unset X-Powered-By
    # HSTS má zmysel len na HTTPS (na HTTP ho prehliadač ignoruje)
    Header always set Strict-Transport-Security "max-age=31536000"
    # CSP: povoľuje len vlastný obsah, inline štýly/skripty používané stránkou,
    # obrázky z Unsplash a vloženú Google Maps na stránke Kontakt.
    Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://images.unsplash.com; font-src 'self' data:; connect-src 'self'; frame-src https://maps.google.com https://www.google.com https://consent.google.com; media-src 'self'; manifest-src 'self'"
</IfModule>

# Kompresia textových odpovedí (SEO: rýchlejšie načítanie, Core Web Vitals)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/json application/xml image/svg+xml
</IfModule>

# Statické assety môžu byť cachované dlhšie, HTML nie (mení sa často)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType application/pdf "access plus 7 days"
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>
