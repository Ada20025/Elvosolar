RewriteEngine On

# Šablóny appky (.html) sa NESMÚ sťahovať priamo — inak by unikol kód/štruktúra appky.
# Idú cez index.php, kde platí prístupová brána (tajný kľúč / prihlásenie).
RewriteRule ^templates/.*\.html$ index.php [L,QSA]

# Ak existuje priamy súbor alebo priečinok, použi ho
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Všetko ostatné presmeruj na index.php
RewriteRule ^(.*)$ index.php [QSA,L]
